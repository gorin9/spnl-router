#!/usr/bin/env ruby
# Usage:
#   spnl-router <controller.rb>            -> router.generated.rb to stdout
#   spnl-router <controller.rb> -o FILE
#   spnl-router <controller.rb> --module-name MyRouter
require_relative "../lib/spnl_router"

if ARGV.empty? || ARGV.include?("-h")
  puts <<~U
    spnl-router v#{SpnlRouter::VERSION}

    Usage:
      spnl-router <controller.rb>              print dispatcher to stdout
      spnl-router <controller.rb> -o FILE      write to file
      spnl-router <controller.rb> --module-name NAME   default: Router

    Input must contain:
      class XxxController
        ROUTES = {
          "/path"  => :action_name,
          "/p/:id" => :action_with_param
        }
        def action_name; ...; end
      end
  U
  exit 0
end

input = ARGV.shift
mod   = "Router"
out   = nil
while (opt = ARGV.shift)
  case opt
  when "-o"             then out = ARGV.shift
  when "--module-name"  then mod = ARGV.shift
  else
    warn "spnl-router: unknown option #{opt}"; exit 1
  end
end

src    = File.read(input)
result = SpnlRouter.generate(src, target_module: mod)

if out
  File.write(out, result)
  puts "wrote #{out}"
else
  print result
end
