#!/usr/bin/env ruby
require 'optparse'
require_relative '../lib/spnl_router'
opts={target_module:'Router',layout:true};output=nil
parser=OptionParser.new do |o|
  o.banner='Usage: spnl-router CONTROLLER.rb [-o FILE] [--module-name NAME] [--no-layout]'
  o.on('-o FILE') { |v| output=v }
  o.on('--module-name NAME') { |v| opts[:target_module]=v }
  o.on('--no-layout') { opts[:layout]=false }
  o.on('-h','--help') { puts o;exit }
end
begin
  parser.parse!
  raise ArgumentError,'expected one controller' unless ARGV.length==1
  code=SpnlRouter.generate(File.read(ARGV[0]),**opts)
  output ? File.write(output,code) : print(code)
rescue ArgumentError,OptionParser::ParseError,Errno::ENOENT => e
  warn "spnl-router: #{e.message}";exit 1
end
